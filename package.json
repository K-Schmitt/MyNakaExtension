{
  "name": "my-naka-extension",
  "version": "0.0.1",
  "private": true,
  "description": "Passerelle entre Naka et SensCritique (extension Chromium, Manifest V3)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "biome check . && tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "check": "npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/chrome": "0.3.5",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
